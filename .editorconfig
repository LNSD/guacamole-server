# EditorConfig helps developers define and maintain consistent
# coding styles between different editors and IDEs
# editorconfig.org
root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,json5}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[Cargo.lock]
indent_size = unset

[*.sh]
indent_size = tab

[Makefile]
indent_style = tab

[{justfile,Justfile}]
insert_final_newline = true
indent_style = space

[{meson.build,meson.options}]
indent_size = 2

[README.md]
indent_size = 2

[LICENSE*]
indent_size = unset

[*.{md,mdx}]
# double whitespace at end of line
# denotes a line break in Markdown
trim_trailing_whitespace = false
